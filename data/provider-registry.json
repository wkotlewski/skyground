    },
    {
      "id": "entity-facts",
      "name": "Wikidata",
      "licenseOrTerms": "CC0-structured-data",
      "documentationUrl": "https://www.wikidata.org/wiki/Wikidata:Licensing",
      "execution": "reviewed-ingestion",
      "capability": "structured-facts",
      "enabled": false
    },
    {
      "id": "place-context",
