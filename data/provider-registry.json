      "licenseOrTerms": "MIT",
      "documentationUrl": "https://github.com/mrdoob/three.js",
      "execution": "client",
      "capability": "3d-space-rendering",
      "enabled": true
    },
    {
      "id": "satellite-calculation",
      "name": "satellite.js",
      "licenseOrTerms": "MIT",
      "documentationUrl": "https://github.com/shashwatak/satellite-js",
      "execution": "client",
      "capability": "satellite-geometry",
      "enabled": true
    },
    {
      "id": "orbital-elements",
      "name": "CelesTrak",
      "licenseOrTerms": "public-service-terms",
      "documentationUrl": "https://celestrak.org/usage-policy.php",
      "execution": "shared-ingestion",
      "capability": "gp-json-omm",
      "enabled": true
    },
    {
      "id": "planet-calculation",
      "name": "Astronomy Engine",
      "licenseOrTerms": "MIT",
      "documentationUrl": "https://github.com/cosinekitty/astronomy",
